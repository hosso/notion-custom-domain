{
  "name": "notion-custom-domain",
  "version": "0.1.0",
  "description": "Custom domains for your Notion pages",
  "license": "MIT",
  "author": "E. Hosso",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "debug": "tsx --env-file-if-exists=.env --inspect src/index.ts",
    "deploy": "npx --yes vercel@latest deploy",
    "deploy:prod": "npx --yes vercel@latest deploy --prod",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "fix": "biome check --write .",
    "lint": "biome check .",
    "monitor:smoke": "node scripts/smoke-monitor.mjs",
    "test": "VERCEL_REGION=test tsx --test src/index.test.mjs",
    "typecheck": "tsc --noEmit",
    "vc:dev": "npx --yes vercel@latest dev",
    "vc:dev:debug": "npx --yes vercel@latest dev --debug"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
